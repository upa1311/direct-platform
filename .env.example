# Auth.js GitHub OAuth. Values are secrets and must only be configured server-side.
AUTH_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Comma-separated immutable numeric GitHub user IDs allowed to use the console.
ADMIN_GITHUB_USER_IDS=

# Neon/PostgreSQL connection and quote-token signing secret.
DATABASE_URL=
QUOTE_TOKEN_SECRET=

# Optional router override. Defaults to the public OSRM service from the server only.
OSRM_BASE_URL=https://router.project-osrm.org
